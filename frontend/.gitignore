# ---------------------------------------------------------------------------
# Sahaay Setu — .gitignore
#
# Deliberately TRACKED, do not add these (each has a reason):
#   package-lock.json      npm is the package manager; CI runs `npm ci`
#   expo-env.d.ts          provides process.env types — `npm run typecheck`
#                          fails on a fresh clone without it
#   .env.example           the template; the real .env is ignored below
#   .checkpoints/          agent session history — project record, not scratch
#   .claude/settings.json  shared project settings (only *.local.json is ignored)
#   assets/                app icons and splash
# ---------------------------------------------------------------------------

# --- Dependencies ----------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Single package manager: npm. A stray lockfile from another one breaks
# `npm ci` in CI. Switching manager = remove the matching line here.
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- Expo / React Native ---------------------------------------------------
.expo/
.expo-shared/
dist/
web-build/
build/
*.hbc

# Generated by `expo prebuild` — regenerate, never commit
/ios/
/android/
.kotlin/

# Metro
.metro-health-check*
.metro-cache/
haste-map-*

# EAS
.easignore
eas-build-local-*/

# --- Secrets and signing ---------------------------------------------------
# Never commit any of these. Use .env.example to document the shape instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.cer
*.certSigningRequest
*.mobileprovision
google-services.json
GoogleService-Info.plist
sentry.properties
secrets.json

# --- Logs and debug --------------------------------------------------------
*.log
logs/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
lerna-debug.*
report.[0-9]*.json

# --- Test and coverage output ----------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
junit.xml
*.lcov

# --- Caches ----------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Editors ---------------------------------------------------------------
.idea/
*.iml
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Agent scratch — shared settings are tracked, machine-local ones are not
.claude/settings.local.json
.claude/**/*.local.json
.cursor/**/*.local.*

# --- OS --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Misc ------------------------------------------------------------------
*.orig
*.orig.*
*.rej
*.bak
*.tmp
tmp/
temp/

