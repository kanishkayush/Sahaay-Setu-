# Copy to .env and adjust. Only EXPO_PUBLIC_* vars reach the app.
#
# ⚠️  These must be read in code as literal `process.env.EXPO_PUBLIC_X` expressions —
#     Expo inlines them by static text substitution at build time. See src/api/config.ts.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# true  → use the bundled mock backend (default; app runs with no server, fully offline)
# false → talk to a real backend at EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_USE_MOCK_API=true

# Base URL of the backend. Ignored while USE_MOCK_API is true.
# Android emulator reaching a host machine: use http://10.0.2.2:8000
# Physical device on the same Wi-Fi: use your machine's LAN IP, e.g. http://192.168.1.5:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Request timeout in ms. The assistant endpoint uses a longer one internally (30s).
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Mock behaviour
# ---------------------------------------------------------------------------

# Simulated latency for the mock backend, so loading states are real during development.
# Set to 0 for instant responses.
EXPO_PUBLIC_MOCK_LATENCY_MS=450
