{
  "expo": {
    "name": "Sahaay Setu",
    "slug": "sahaay-setu",
    "scheme": "sahaaysetu",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B4F6C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gov.mosje.sahaaysetu",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only to find the nearest authorised Channel Partner branch for your loan application.",
        "NSMicrophoneUsageDescription": "The microphone is used so you can ask questions by voice in your own language."
      }
    },
    "android": {
      "package": "in.gov.mosje.sahaaysetu",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0B4F6C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only to find the nearest authorised Channel Partner branch for your loan application."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
